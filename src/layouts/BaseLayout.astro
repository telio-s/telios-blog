---
import "../styles/globals.css";
import { defaultLocale, type Locale } from "@/i18n";
import { getHreflangLinks } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  lang?: Locale;
  alternates?: Record<Locale | "x-default", string>;
}

const {
  title = "Telio the Builder",
  description = "Personal brand and consulting portfolio for business owners turning ideas into software.",
  image = "/t-logo-bg-small.png",
  type = "website",
  lang = defaultLocale,
  canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString(),
  alternates = getHreflangLinks(Astro.url.pathname, Astro.site ?? Astro.url),
} = Astro.props;

const pageTitle = title === "Telio the Builder" ? title : `${title} | Telio the Builder`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="icon" type="image/png" href="/t-logo-bg-small.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#a24b2f" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
