---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BottomNav from "@/components/BottomNav.astro";
import Footer from "@/components/Footer.astro";
import type { LocalizedEntry } from "@/lib/localized-content";

interface Props {
  project: CollectionEntry<"projects">;
  localizedProject?: LocalizedEntry<"projects">;
}

const { project, localizedProject } = Astro.props;
const projects = localizedProject ?? { en: project, th: project };
const { Content: EnglishContent } = await render(projects.en);
const { Content: ThaiContent } = await render(projects.th);
---

<BaseLayout title={projects.en.data.title} description={projects.en.data.description}>
  <BottomNav />
  <main>
    <article class="site-container py-12 sm:py-16">
      <a href="/projects" class="text-sm font-semibold text-primary hover:underline" data-i18n="project.back">Back to projects</a>
      <header class="mt-8 grid gap-8 border-y border-border/80 py-10 md:grid-cols-12">
        <div class="md:col-span-3">
          <p class="micro-label">
            <span data-locale="en">{projects.en.data.status}</span>
            <span data-locale="th" hidden>{projects.th.data.status}</span>
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <span class="rounded-sm border border-border/80 bg-[hsl(var(--surface-muted)/0.65)] px-2.5 py-1 text-xs font-semibold text-muted-foreground">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="md:col-span-8">
          <h1 class="text-4xl font-semibold leading-tight text-foreground sm:text-6xl">
            <span data-locale="en">{projects.en.data.title}</span>
            <span data-locale="th" hidden>{projects.th.data.title}</span>
          </h1>
          <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">
            <span data-locale="en">{projects.en.data.description}</span>
            <span data-locale="th" hidden>{projects.th.data.description}</span>
          </p>
        </div>
      </header>
      <div class="mx-auto mt-12 max-w-3xl editorial-prose" data-locale="en">
        <EnglishContent />
      </div>
      <div class="mx-auto mt-12 max-w-3xl editorial-prose" data-locale="th" hidden>
        <ThaiContent />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
