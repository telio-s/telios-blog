---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BottomNav from "@/components/BottomNav.astro";
import Footer from "@/components/Footer.astro";
import type { LocalizedEntry } from "@/lib/localized-content";
import { getAlternateLanguage, getTranslations, localizePath, type Locale } from "@/i18n";
import { getAbsoluteUrl, getHreflangLinks } from "@/lib/seo";

interface Props {
  project: CollectionEntry<"projects">;
  localizedProject: LocalizedEntry<"projects">;
  lang: Locale;
}

const { project, localizedProject, lang } = Astro.props;
const t = getTranslations(lang);
const alternateLang = getAlternateLanguage(lang);
const { Content } = await render(project);
const canonicalPath = localizePath(lang, `/projects/${project.data.translationKey}/`);
const alternatePath = localizePath(alternateLang, `/projects/${localizedProject[alternateLang].data.translationKey}/`);
const canonical = getAbsoluteUrl(canonicalPath, Astro.site ?? Astro.url);
const alternates = getHreflangLinks(canonicalPath, Astro.site ?? Astro.url);
---

<BaseLayout title={project.data.title} description={project.data.description} lang={lang} canonical={canonical} alternates={alternates}>
  <BottomNav lang={lang} alternatePath={alternatePath} />
  <main>
    <article class="site-container py-12 sm:py-16">
      <a href={localizePath(lang, "/projects/")} class="text-sm font-semibold text-primary hover:underline">{t.project.back}</a>
      <header class="mt-8 grid gap-8 border-y border-border/80 py-10 md:grid-cols-12">
        <div class="md:col-span-3">
          <p class="micro-label">{project.data.status}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <span class="rounded-sm border border-border/80 bg-[hsl(var(--surface-muted)/0.65)] px-2.5 py-1 text-xs font-semibold text-muted-foreground">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="md:col-span-8">
          <h1 class="text-4xl font-semibold leading-tight text-foreground sm:text-6xl">{project.data.title}</h1>
          <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">{project.data.description}</p>
        </div>
      </header>
      <div class="mx-auto mt-12 max-w-3xl editorial-prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>
