---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="pb-8">
  {eyebrow && <p class="micro-label">{eyebrow}</p>}
  <h2 class="mt-5 max-w-4xl pl-6 text-3xl font-semibold leading-tight text-foreground sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">{description}</p>}
</div>
