---
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import { localizePath, type Locale } from "@/i18n";

interface Props {
  article: CollectionEntry<"articles">;
  lang: Locale;
  featured?: boolean;
}

const { article, lang, featured = false } = Astro.props;
const date = article.data.publishedAt.toLocaleDateString(lang === "th" ? "th-TH" : "en", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const readingTime = article.data.readingTime ?? (lang === "th" ? "อ่าน 5 นาที" : "5 min read");
---

<article class:list={["group border-b border-dashed border-border/80 py-7", featured && "md:grid md:grid-cols-12 md:gap-8 md:py-10"]}>
  <div class:list={[featured ? "md:col-span-3" : ""]}>
    <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-muted-foreground">
      <Badge label={article.data.category} />
      <span>{readingTime}</span>
      <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
    </div>
  </div>
  <a href={localizePath(lang, `/articles/${article.data.translationKey}/`)} class:list={["mt-4 block", featured && "md:col-span-8 md:mt-0"]}>
    <h3 class:list={[
      "max-w-4xl font-semibold leading-tight text-foreground transition-colors group-hover:text-primary",
      featured ? "text-3xl sm:text-5xl" : "text-2xl",
    ]}>
      {article.data.title}
    </h3>
    <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">{article.data.description}</p>
  </a>
</article>
