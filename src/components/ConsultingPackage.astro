---
import ButtonLink from "@/components/ButtonLink.astro";
import { createContactMailto } from "@/config/site";
import { getTranslations, type Locale } from "@/i18n";

interface Props {
  number: string;
  name: string;
  description: string;
  recommendedFor: string;
  startingPrice: string;
  deliverables: string[];
  engagement: string;
  notes?: string;
  lang: Locale;
}

const {
  number,
  name,
  description,
  recommendedFor,
  startingPrice,
  deliverables,
  engagement,
  notes,
  lang,
} = Astro.props;

const t = getTranslations(lang);
const engagementMailto = createContactMailto(`Discuss ${name} Service`);
---

<section class="grid gap-6 border-b border-border/80 py-10 md:grid-cols-12">
  <div class="md:col-span-2">
    <p class="text-5xl font-semibold text-primary/35">{number}</p>
  </div>
  <div class="md:col-span-5">
    <h2 class="text-3xl font-semibold leading-tight text-foreground">{name}</h2>
    <p class="mt-4 text-lg leading-8 text-muted-foreground">{description}</p>
  </div>
  <div class="grid gap-6 text-sm md:col-span-5">
    <div>
      <p class="micro-label">{t.consulting.labels.recommendedFor}</p>
      <p class="mt-2 leading-7 text-foreground/85">{recommendedFor}</p>
    </div>
    <div>
      <p class="micro-label">{t.consulting.labels.startingPrice}</p>
      <p class="mt-2 font-semibold text-foreground">{startingPrice}</p>
    </div>
    <div>
      <p class="micro-label">{t.consulting.labels.deliverables}</p>
      <ul class="mt-3 space-y-2 text-muted-foreground">
        {deliverables.map((item) => <li class="leading-6">- {item}</li>)}
      </ul>
    </div>
    <div>
      <p class="micro-label">{t.consulting.labels.engagement}</p>
      <p class="mt-2 leading-7 text-muted-foreground">{engagement}</p>
      <div class="mt-4">
        <ButtonLink href={engagementMailto} class="shadow-lg shadow-primary/20">
          {t.consulting.ctaDiscuss}
        </ButtonLink>
      </div>
    </div>
    {notes && (
      <div class="rounded-md border border-primary/20 bg-[hsl(var(--accent-soft)/0.45)] p-4 text-sm leading-6 text-foreground/80">
        {notes}
      </div>
    )}
  </div>
</section>
