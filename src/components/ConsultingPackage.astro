---
import ButtonLink from "@/components/ButtonLink.astro";
import { createContactMailto } from "@/config/site";
import type { LocalizedEntry } from "@/lib/localized-content";

interface Props {
  number: string;
  name: string;
  description: string;
  recommendedFor: string;
  startingPrice: string;
  deliverables: string[];
  engagement: string;
  notes?: string;
  localizedPackage?: LocalizedEntry<"consultingPackages">;
}

const {
  number,
  name,
  description,
  recommendedFor,
  startingPrice,
  deliverables,
  engagement,
  notes,
  localizedPackage,
} = Astro.props;

const packageEntries = localizedPackage;
const engagementMailto = createContactMailto(`Discuss ${name} Service`);
---

<section class="grid gap-6 border-b border-border/80 py-10 md:grid-cols-12">
  <div class="md:col-span-2">
    <p class="text-5xl font-semibold text-primary/35">{number}</p>
  </div>
  <div class="md:col-span-5">
    <h2 class="text-3xl font-semibold leading-tight text-foreground">
      <span data-locale="en">{packageEntries?.en.data.name ?? name}</span>
      <span data-locale="th" hidden>{packageEntries?.th.data.name ?? name}</span>
    </h2>
    <p class="mt-4 text-lg leading-8 text-muted-foreground">
      <span data-locale="en">{packageEntries?.en.data.description ?? description}</span>
      <span data-locale="th" hidden>{packageEntries?.th.data.description ?? description}</span>
    </p>
  </div>
  <div class="grid gap-6 text-sm md:col-span-5">
    <div>
      <p class="micro-label" data-i18n="consulting.label.recommendedFor">Recommended for</p>
      <p class="mt-2 leading-7 text-foreground/85">
        <span data-locale="en">{packageEntries?.en.data.recommendedFor ?? recommendedFor}</span>
        <span data-locale="th" hidden>{packageEntries?.th.data.recommendedFor ?? recommendedFor}</span>
      </p>
    </div>
    <div>
      <p class="micro-label" data-i18n="consulting.label.startingPrice">Starting price</p>
      <p class="mt-2 font-semibold text-foreground">
        <span data-locale="en">{packageEntries?.en.data.startingPrice ?? startingPrice}</span>
        <span data-locale="th" hidden>{packageEntries?.th.data.startingPrice ?? startingPrice}</span>
      </p>
    </div>
    <div>
      <p class="micro-label" data-i18n="consulting.label.deliverables">Deliverables</p>
      <ul class="mt-3 space-y-2 text-muted-foreground" data-locale="en">
        {(packageEntries?.en.data.deliverables ?? deliverables).map((item) => <li class="leading-6">- {item}</li>)}
      </ul>
      <ul class="mt-3 space-y-2 text-muted-foreground" data-locale="th" hidden>
        {(packageEntries?.th.data.deliverables ?? deliverables).map((item) => <li class="leading-6">- {item}</li>)}
      </ul>
    </div>
    <div>
      <p class="micro-label" data-i18n="consulting.label.engagement">Engagement</p>
      <p class="mt-2 leading-7 text-muted-foreground">
        <span data-locale="en">{packageEntries?.en.data.engagement ?? engagement}</span>
        <span data-locale="th" hidden>{packageEntries?.th.data.engagement ?? engagement}</span>
      </p>
      <div class="mt-4">
        <ButtonLink href={engagementMailto} class="shadow-lg shadow-primary/20">
          <span data-i18n="consulting.cta.discuss">Discuss an engagement</span>
        </ButtonLink>
      </div>
    </div>
    {notes && (
      <div class="rounded-md border border-primary/20 bg-[hsl(var(--accent-soft)/0.45)] p-4 text-sm leading-6 text-foreground/80">
        <span data-locale="en">{packageEntries?.en.data.notes ?? notes}</span>
        <span data-locale="th" hidden>{packageEntries?.th.data.notes ?? notes}</span>
      </div>
    )}
  </div>
</section>
