---
import { contactEmail, contactMailto } from "@/config/site";
import { getTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<footer class="border-t border-border/80 bg-[hsl(var(--surface-muted)/0.45)]">
  <div class="site-container flex flex-col justify-between gap-8 py-10 md:flex-row md:items-start">
    <div>
      <p class="text-sm font-bold text-foreground">Telio the Builder</p>
      <p class="mt-3 max-w-md text-sm leading-6 text-muted-foreground">{t.footer.body}</p>
    </div>
    <div class="text-sm text-muted-foreground md:text-right">
      <a class="hover:text-primary" href={contactMailto}>{contactEmail}</a>
      <p class="mt-2">&copy; {new Date().getFullYear()} Telio the Builder</p>
    </div>
  </div>
</footer>
