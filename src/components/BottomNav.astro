---
import { contactMailto } from "@/config/site";
import { getAlternateLanguage, getTranslations, localizePath, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
  alternatePath?: string;
}

const { lang, alternatePath } = Astro.props;
const t = getTranslations(lang);
const alternateLang = getAlternateLanguage(lang);
const navItems = [
  { href: localizePath(lang), label: t.nav.home },
  { href: localizePath(lang, "/articles/"), label: t.nav.articles },
  { href: localizePath(lang, "/projects/"), label: t.nav.projects },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const languageHref = alternatePath ?? localizePath(alternateLang, Astro.url.pathname);
const homePath = localizePath(lang).replace(/\/$/, "") || "/";
---

<nav
  class="fixed inset-x-3 bottom-4 z-40 mx-auto flex max-w-2xl items-center justify-between gap-1 rounded-[20px] border border-border/80 bg-background/60 px-2 py-2 shadow-lg shadow-foreground/10 backdrop-blur-md sm:inset-x-4 sm:bottom-6 sm:gap-2 sm:px-4"
  aria-label="Main navigation"
>
  <a href={localizePath(lang)} class="hidden shrink-0 px-2 text-sm font-bold text-foreground sm:inline-flex sm:text-base" aria-label="Telio the Builder home">
    Telio the Builder
  </a>

  <div class="flex min-w-0 flex-1 items-center justify-center gap-1 text-sm text-muted-foreground sm:flex-none">
    {navItems.map((item) => {
      const itemPath = item.href.replace(/\/$/, "") || "/";
      const isActive = itemPath === homePath ? currentPath === homePath : currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
      return (
        <a
          href={item.href}
          class:list={[
            "rounded-md px-2 py-2 text-center transition-colors hover:bg-[hsl(var(--accent-soft)/0.55)] hover:text-foreground sm:px-3",
            isActive && "bg-[hsl(var(--accent)/0.65)] text-foreground",
          ]}
        >
          <span>{item.label}</span>
        </a>
      );
    })}
  </div>

  <div class="flex items-center gap-0">
    <a
      href={languageHref}
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-card/70 hover:text-foreground"
      aria-label={t.nav.languageToggle}
    >
      <svg
        class="h-5 w-5"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 0 20"></path>
        <path d="M12 2a15.3 15.3 0 0 0 0 20"></path>
      </svg>
    </a>

    <a
      href={contactMailto}
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-foreground transition-colors hover:bg-card/70"
      aria-label="Contact by email"
    >
      <svg
        class="h-5 w-5"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    </a>
  </div>
</nav>
