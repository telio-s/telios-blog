---
import type { CollectionEntry } from "astro:content";
import { getTranslations, localizePath, type Locale } from "@/i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = getTranslations(lang);
---

<article class="notion-block group min-h-72 p-6 md:p-8">
  <div>
    <p class="micro-label">{project.data.status}</p>
  </div>
  <div class="mt-4 flex flex-wrap gap-2">
      {project.data.tags.map((tag) => (
        <span class="rounded-sm border border-border/80 bg-[hsl(var(--surface-muted)/0.6)] px-2 py-1 text-xs font-medium text-muted-foreground">
          {tag}
        </span>
      ))}
    </div>
  <a href={localizePath(lang, `/projects/${project.data.translationKey}/`)} class="mt-4 block max-w-4xl">
    <h3 class="text-4xl font-semibold leading-tight text-foreground transition-colors group-hover:text-primary">
      {project.data.title}
    </h3>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">{project.data.description}</p>
    <p class="mt-8 text-sm font-semibold text-primary">{t.project.readCaseStudy}</p>

    
  </a>
</article>
