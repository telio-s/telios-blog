---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  label?: string;
  class?: string;
}

const { href, variant = "primary", label, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold transition-colors",
    variant === "primary" && "bg-primary text-primary-foreground hover:bg-[hsl(var(--accent))]",
    variant === "secondary" && "border border-border/90 bg-card/55 text-foreground hover:border-primary/50 hover:bg-card",
    className,
  ]}
>
  <slot>{label}</slot>
</a>
