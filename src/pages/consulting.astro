---
import { getAbsoluteUrl } from "@/lib/seo";

const redirectPath = "/en/consulting/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${redirectPath}`} />
    <link rel="canonical" href={getAbsoluteUrl(redirectPath, Astro.site ?? Astro.url)} />
    <title>Redirecting to consulting</title>
  </head>
  <body>
    <p><a href={redirectPath}>Continue to consulting</a></p>
  </body>
</html>
