---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BottomNav from "@/components/BottomNav.astro";
import Footer from "@/components/Footer.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ArticleListItem from "@/components/ArticleListItem.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getLocalizedEntryPairs, isPublicLocalizedEntry } from "@/lib/localized-content";
import { getTranslations, locales, localizePath, type Locale } from "@/i18n";
import { getAbsoluteUrl, getHreflangLinks } from "@/lib/seo";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const t = getTranslations(lang);
const articles = getLocalizedEntryPairs(await getCollection("articles"))
  .filter(isPublicLocalizedEntry)
  .sort((a, b) => b[lang].data.publishedAt.valueOf() - a[lang].data.publishedAt.valueOf());
const featuredArticles = articles.filter((article) => article[lang].data.featured).slice(0, 4);
const projects = getLocalizedEntryPairs(await getCollection("projects"))
  .filter(isPublicLocalizedEntry)
  .filter((project) => project[lang].data.featured);

const canonicalPath = localizePath(lang);
const canonical = getAbsoluteUrl(canonicalPath, Astro.site ?? Astro.url);
const alternates = getHreflangLinks(canonicalPath, Astro.site ?? Astro.url);
---

<BaseLayout title={t.meta.siteName} description={t.meta.homeDescription} lang={lang} canonical={canonical} alternates={alternates}>
  <BottomNav lang={lang} />

  <main>
    <section class="hairline-y grid-frame">
      <div class="site-container grid gap-10 py-16 sm:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="micro-label">{t.home.hero.eyebrow}</p>
          <h1 class="mt-7 max-w-5xl text-5xl font-semibold leading-[1.02] text-foreground sm:text-7xl lg:text-8xl" set:html={t.home.hero.title} />
        </div>
        <div class="self-end rounded-[16px] border border-border/80 bg-card/95 p-6 shadow-xl shadow-foreground/10 lg:col-span-4">
          <p class="text-lg leading-8 text-muted-foreground" set:html={t.home.hero.body} />
          <div class="mt-8 flex flex-wrap gap-3">
            <ButtonLink href={localizePath(lang, "/articles/")}>{t.home.hero.ctaArticles}</ButtonLink>
          </div>
        </div>
      </div>
    </section>

    <section class="site-container py-16 sm:py-20">
      <SectionHeading
        eyebrow={t.home.help.eyebrow}
        title={t.home.help.title}
        description={t.home.help.description}
      />
      <div class="grid border-l border-t border-border/80 md:grid-cols-2">
        {t.home.help.areas.map((item, index) => (
          <article class="min-h-64 border-b border-r border-border/80 bg-card/35 p-6 sm:p-8">
            <p class="text-sm font-semibold text-primary/70">0{index + 1}</p>
            <h3 class="mt-8 text-2xl font-semibold text-foreground">{item.title}</h3>
            <p class="mt-4 max-w-xl text-base leading-7 text-muted-foreground">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="hairline-y bg-[hsl(var(--surface-muted)/0.38)]">
      <div class="site-container grid gap-10 py-16 sm:py-20 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="micro-label">{t.home.perspective.eyebrow}</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight text-foreground">{t.home.perspective.title}</h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-muted-foreground lg:col-span-7 lg:col-start-6">
          {t.home.perspective.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="site-container py-16 sm:py-20">
      <SectionHeading eyebrow={t.home.articles.eyebrow} title={t.home.articles.title} />
      <div class="px-4 border-x-[1px] border-border/80">
        {featuredArticles.map((article) => (
          <ArticleListItem article={article[lang]} lang={lang} />
        ))}
      </div>
    </section>

    <section class="site-container pb-16 sm:pb-24">
      <SectionHeading eyebrow={t.home.projects.eyebrow} title={t.home.projects.title} />
      <div class="mt-10 grid gap-5">
        {projects.map((project) => <ProjectCard project={project[lang]} lang={lang} />)}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <style>
    :global(html[lang="th"]) h1 {
      font-size: clamp(2.225rem, 6vw, 4.85rem);
      line-height: 1.28;
    }
  </style>
</BaseLayout>
