---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BottomNav from "@/components/BottomNav.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getLocalizedEntryPairs, isPublicLocalizedEntry } from "@/lib/localized-content";
import { getTranslations, locales, localizePath, type Locale } from "@/i18n";
import { getAbsoluteUrl, getHreflangLinks } from "@/lib/seo";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const t = getTranslations(lang);
const projects = getLocalizedEntryPairs(await getCollection("projects")).filter(isPublicLocalizedEntry);
const canonicalPath = localizePath(lang, "/projects/");
const canonical = getAbsoluteUrl(canonicalPath, Astro.site ?? Astro.url);
const alternates = getHreflangLinks(canonicalPath, Astro.site ?? Astro.url);
---

<BaseLayout title={t.nav.projects} description={t.meta.projectsDescription} lang={lang} canonical={canonical} alternates={alternates}>
  <BottomNav lang={lang} />
  <main class="site-container py-12 sm:py-16">
    <header class="grid gap-8 border-y border-border/80 py-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="micro-label">{t.projectsIndex.eyebrow}</p>
      </div>
      <div class="md:col-span-8">
        <h1 class="text-5xl font-semibold leading-tight text-foreground sm:text-7xl">{t.projectsIndex.title}</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">{t.projectsIndex.description}</p>
      </div>
    </header>

    <section class="mt-10 grid gap-5">
      {projects.map((project) => <ProjectCard project={project[lang]} lang={lang} />)}
    </section>
  </main>
  <Footer lang={lang} />
  <style>
    :global(html[lang="th"]) h1 {
      line-height: 1.48;
    }
  </style>
</BaseLayout>
