---
import { getCollection } from "astro:content";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { getLocalizedEntryPairs, isPublicLocalizedEntry } from "@/lib/localized-content";
import { locales, type Locale } from "@/i18n";

export async function getStaticPaths() {
  const projects = getLocalizedEntryPairs(await getCollection("projects")).filter(isPublicLocalizedEntry);

  return projects.flatMap((project) =>
    locales.map((lang) => ({
      params: { lang, slug: project[lang].data.translationKey },
      props: { project: project[lang], localizedProject: project, lang },
    })),
  );
}

const { project, localizedProject, lang } = Astro.props as Astro.Props & { lang: Locale };
---

<ProjectLayout project={project} localizedProject={localizedProject} lang={lang} />
