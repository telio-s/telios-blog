---
import { defaultLocale, localizePath } from "@/i18n";

const defaultHref = localizePath(defaultLocale);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${defaultHref}`} />
    <link rel="canonical" href={new URL(defaultHref, Astro.site ?? Astro.url).toString()} />
    <title>Redirecting to Telio the Builder</title>
  </head>
  <body>
    <p><a href={defaultHref}>Continue to Telio the Builder</a></p>
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const queryLanguage = params.get("lang");
      const storedLanguage = window.localStorage.getItem("language");
      const language = queryLanguage === "th" || queryLanguage === "en" ? queryLanguage : storedLanguage === "th" || storedLanguage === "en" ? storedLanguage : "en";
      window.location.replace(`/${language}/`);
    </script>
  </body>
</html>
